<%- include('_header') %>

<h1 class="page-title">Comenzi <span class="muted count"><%= comenzi.length %></span></h1>

<form method="get" class="toolbar card">
  <input name="q" value="<%= f.q || '' %>" placeholder="Număr comandă, nume sau email client...">
  <select name="status">
    <option value="">Toate statusurile</option>
    <% for (const [k, v] of Object.entries(STATUS_COMANDA)) { %><option value="<%= k %>" <%= f.status === k ? 'selected' : '' %>><%= v %></option><% } %>
  </select>
  <button class="btn-accent">Filtrează</button>
</form>

<div class="card">
  <table class="table">
    <thead><tr><th>Număr</th><th>Data</th><th>Client</th><th>Livrare</th><th>Plată</th><th>Status</th><th class="right">Total</th><th></th></tr></thead>
    <tbody>
      <% comenzi.forEach(c => { %>
        <tr>
          <td><b><%= c.numar_comanda %></b></td>
          <td class="small"><%= dataOra(c.data_comanda) %></td>
          <td><%= c.client %><br><span class="muted small"><%= c.email %></span></td>
          <td class="small"><%= c.oras_livrare %></td>
          <td class="small"><%= PLATA[c.metoda_plata] %></td>
          <td><span class="status s-<%= c.status %>"><%= STATUS_COMANDA[c.status] %></span></td>
          <td class="right"><b><%= lei(c.total) %></b></td>
          <td class="right"><a href="/admin/comenzi/<%= c.id_comanda %>" class="btn-ghost btn-sm">Detalii</a></td>
        </tr>
      <% }) %>
      <% if (!comenzi.length) { %><tr><td colspan="8" class="muted">Nicio comandă găsită.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('_footer') %>
