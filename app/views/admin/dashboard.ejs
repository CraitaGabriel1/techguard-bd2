<%- include('_header') %>

<h1 class="page-title">Bun venit, <%= user.prenume %>!</h1>

<div class="stats">
  <a href="/admin/produse" class="card stat"><span class="muted">Produse active</span><b><%= stat.produse_active %></b></a>
  <a href="/admin/produse?stare=stoc_redus" class="card stat warn"><span class="muted">Stoc redus (≤ 5)</span><b><%= stat.stoc_redus %></b></a>
  <a href="/admin/comenzi" class="card stat"><span class="muted">Comenzi de procesat</span><b><%= stat.comenzi_de_procesat %></b></a>
  <div class="card stat"><span class="muted">Vânzări luna aceasta</span><b><%= lei(stat.vanzari_luna) %> lei</b></div>
  <a href="/admin/service" class="card stat"><span class="muted">Cereri service deschise</span><b><%= stat.service_deschise %></b></a>
  <div class="card stat"><span class="muted">Clienți</span><b><%= stat.clienti %></b></div>
</div>

<div class="two-cols">
  <div class="card">
    <div class="card-head"><h3>Ultimele comenzi</h3><a href="/admin/comenzi" class="small accent">Toate →</a></div>
    <table class="table">
      <% ultimeleComenzi.forEach(c => { %>
        <tr>
          <td><a href="/admin/comenzi/<%= c.id_comanda %>"><b><%= c.numar_comanda %></b></a><br><span class="muted small"><%= c.client %></span></td>
          <td><span class="status s-<%= c.status %>"><%= STATUS_COMANDA[c.status] %></span></td>
          <td class="right"><b><%= lei(c.total) %></b></td>
        </tr>
      <% }) %>
    </table>
  </div>
  <div class="card">
    <div class="card-head"><h3>Stoc redus</h3><a href="/admin/stoc" class="small accent">Stocuri →</a></div>
    <table class="table">
      <% stocRedus.forEach(p => { %>
        <tr>
          <td><a href="/admin/produse/<%= p.id_produs %>/editeaza"><%= p.nume %></a></td>
          <td class="right"><span class="status <%= p.stoc === 0 ? 's-anulata' : 's-procesata' %>"><%= p.stoc %> buc.</span></td>
        </tr>
      <% }) %>
      <% if (!stocRedus.length) { %><tr><td class="muted">Toate produsele au stoc suficient.</td></tr><% } %>
    </table>
  </div>
</div>

<%- include('_footer') %>
