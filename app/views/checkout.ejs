<%- include('partials/header') %>

<h1 class="page-title">Finalizează comanda</h1>

<form action="/checkout" method="post" class="cart-layout">
  <div class="card form-card">
    <h3>Date de livrare</h3>
    <div class="form grid-2">
      <label class="span-2">Adresă *<input name="adresa" value="<%= u.adresa || '' %>" required></label>
      <label>Oraș *<input name="oras" value="<%= u.oras || '' %>" required></label>
      <label>Județ *<input name="judet" value="<%= u.judet || '' %>" required></label>
      <label>Telefon *<input name="telefon" value="<%= u.telefon || '' %>" maxlength="15" required></label>
      <label>Metoda de plată *
        <select name="metoda_plata" required>
          <% for (const [k, v] of Object.entries(PLATA)) { %><option value="<%= k %>"><%= v %></option><% } %>
        </select>
      </label>
      <label class="span-2">Observații<textarea name="observatii" rows="3" placeholder="ex: Sunați înainte de livrare"></textarea></label>
    </div>
  </div>

  <aside class="card summary">
    <h3>Produsele comandate</h3>
    <% produse.forEach(p => { %>
      <div class="row-between small"><span><%= p.cantitate %> × <%= p.nume %></span><span><%= lei(p.subtotal) %></span></div>
    <% }) %>
    <hr>
    <div class="row-between"><span>Produse</span><span><%= lei(subtotal) %> lei</span></div>
    <div class="row-between"><span>Transport</span><span><%= transport ? lei(transport) + ' lei' : 'Gratuit' %></span></div>
    <hr>
    <div class="row-between total"><span>Total de plată</span><span><%= lei(subtotal + transport) %> lei</span></div>
    <button class="btn-accent btn-lg btn-block">Plasează comanda</button>
    <a href="/cos" class="btn-ghost btn-block center">← Înapoi la coș</a>
  </aside>
</form>

<%- include('partials/footer') %>
