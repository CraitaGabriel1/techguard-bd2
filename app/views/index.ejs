<%- include('partials/header') %>

<!-- ================= BANNER ROTATIV (carusel) =================
     Primul card = promoția; celelalte = „vedetele” fiecărei categorii,
     alese din baza de date (cel mai scump produs aflat în stoc). -->
<section class="hero-carousel slider" data-autoplay="4500">
  <div class="slider-track">
    <article class="hc-card hc-promo">
      <span class="tag">Noiembrie 2026</span>
      <h1>Tehnologia de care ai nevoie,<br><span class="accent">la un click distanță.</span></h1>
      <p>Componente PC, laptopuri, console, periferice și jocuri. Plus service propriu pentru reparații.</p>
      <div class="hero-btns">
        <a href="/produse" class="btn-accent btn-lg">Vezi produsele →</a>
        <a href="/service" class="btn-ghost btn-lg">Service</a>
      </div>
    </article>

    <% vedete.forEach((p, i) => { %>
      <a href="/produs/<%= p.id_produs %>" class="hc-card hc-product" style="--i: <%= i %>">
        <span class="hc-label"><%= p.categorie_principala %></span>
        <div class="hc-stage">
          <span class="hc-pedestal"></span>
          <% if (p.imagine_url) { %><img src="<%= p.imagine_url %>" alt=""><% } %>
        </div>
        <div class="hc-info">
          <h3><%= p.nume %></h3>
          <div class="hc-buy">
            <span class="price"><%= lei(p.pret) %> <small>lei</small></span>
            <span class="btn-accent btn-sm">Comandă acum ›</span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
  <button class="slider-btn prev" aria-label="Înapoi">‹</button>
  <button class="slider-btn next" aria-label="Înainte">›</button>
  <div class="slider-dots"></div>
</section>

<!-- ================= CATEGORII cu imagine (de la X lei din BD) ================= -->
<section class="section">
  <div class="section-head">
    <div>
      <h2>Categorii</h2>
      <p>Tot ce îți trebuie pentru setup-ul tău.</p>
    </div>
    <a href="/produse" class="btn-ghost">Toate produsele →</a>
  </div>

  <div class="cat-tiles">
    <% categorii.forEach(cat => { %>
      <a href="/categorie/<%= cat.slug %>" class="card cat-tile">
        <div class="cat-tile-text">
          <h3><%= cat.nume %></h3>
          <% if (cat.pret_minim) { %>
            <span class="muted small">de la <b class="accent"><%= lei(cat.pret_minim) %> lei</b> · <%= cat.nr_produse %> produse</span>
          <% } else { %>
            <span class="muted small">în curând</span>
          <% } %>
        </div>
        <% if (cat.imagine) { %><img src="<%= cat.imagine %>" alt="" class="cat-tile-img"><% } %>
        <span class="cat-arrow">→</span>
      </a>
    <% }) %>
  </div>
</section>

<% if (topVanzari.length) { %>
<!-- ================= CELE MAI VÂNDUTE (slider orizontal) ================= -->
<section class="section">
  <div class="section-head">
    <div>
      <h2>🔥 Cele mai vândute</h2>
      <p>Produsele alese cel mai des de clienții noștri.</p>
    </div>
  </div>
  <div class="slider product-slider">
    <div class="slider-track">
      <% topVanzari.forEach(p => { %><%- include('partials/produs-card', { p }) %><% }) %>
    </div>
    <button class="slider-btn prev" aria-label="Înapoi">‹</button>
    <button class="slider-btn next" aria-label="Înainte">›</button>
  </div>
</section>
<% } %>

<!-- ================= SERVICE ================= -->
<section class="section service-banner card">
  <div>
    <span class="tag">🔧 Service TECHGUARD</span>
    <h2>PC-ul, laptopul sau consola nu mai merg cum trebuie?</h2>
    <p class="muted">Diagnosticare, curățare, reinstalare, reparații pentru console și periferice. Urmărești online fiecare etapă a reparației.</p>
    <a href="/service" class="btn-accent btn-lg">Trimite o cerere de service</a>
  </div>
  <div class="service-list">
    <% servicii.forEach(s => { %>
      <a href="/service?serviciu=<%= s.id_serviciu %>#cerere" class="service-item">
        <span><%= s.nume %></span>
        <b>de la <%= lei(s.pret_estimativ) %> lei <span class="accent">›</span></b>
      </a>
    <% }) %>
  </div>
</section>

<!-- ================= NOUTĂȚI (slider orizontal) ================= -->
<section class="section">
  <div class="section-head">
    <div>
      <h2>✨ Noutăți</h2>
      <p>Cele mai recente produse adăugate în magazin.</p>
    </div>
    <a href="/produse?sort=noi" class="btn-ghost">Vezi toate →</a>
  </div>
  <div class="slider product-slider">
    <div class="slider-track">
      <% noutati.forEach(p => { %><%- include('partials/produs-card', { p }) %><% }) %>
    </div>
    <button class="slider-btn prev" aria-label="Înapoi">‹</button>
    <button class="slider-btn next" aria-label="Înainte">›</button>
  </div>
</section>

<%- include('partials/footer') %>
